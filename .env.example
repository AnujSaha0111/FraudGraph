FG_ENV=dev

# API
FG_API_HOST=127.0.0.1
FG_API_PORT=8000
FG_LOG_LEVEL=INFO

# Storage (DuckDB file; created on first init / scripts/bootstrap_db.py)
# FG_DB_PATH=data/app/fraudgraph.duckdb

# Data locations (defaults relative to repo root)
# FG_DATA_DIR=data
# FG_REPORTS_DIR=reports
# FG_MODEL_DIR=models

# Graph strategy constants (window -14d/+2d, hub guard, neighbor cap)
# FG_HUB_DEGREE_MAX=1000
# FG_WINDOW_BACK_DAYS=14
# FG_WINDOW_FWD_DAYS=2
# FG_NEIGHBOR_CAP=200
# FG_EXPANSION_DEPTH=1

# Demo parameters
# FG_DEMO_SEED=42

# Delayed-label EntityRisk:
# a label is eligible for EntityRisk at query time T only if
# arrival_at <= T - MIN_LABEL_LAG_DAYS. Stated chargeback-latency assumption.
# FG_MIN_LABEL_LAG_DAYS=7
